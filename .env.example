PORT=5000
MONGO_URI=mongodb://mongo:27017/homelab

# SECURITY: Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never commit the real value. Never use a short or guessable string.
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars

# Restrict cross-origin requests to your actual frontend origin.
# Example: http://localhost:3000 for local dev, https://yourapp.com in production.
ALLOWED_ORIGIN=http://localhost:3000
